# Normalize line endings to LF in the repository
* text=auto eol=lf

# Explicitly force LF for these file types
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.txt text eol=lf
Dockerfile text eol=lf
*.sh text eol=lf

# Binary files — do not touch line endings
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
