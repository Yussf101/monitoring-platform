# PostgreSQL
POSTGRES_USER=changeme_user
POSTGRES_PASSWORD=changeme_password
POSTGRES_DB=monitoring_platform
DATABASE_URL=postgresql+asyncpg://changeme_user:changeme_password@db:5432/monitoring_platform

# FastAPI
BACKEND_PORT=8000

# Telegram (obtain from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
